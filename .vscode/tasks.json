{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Outreach Color Server",
      "type": "shell",
      "command": "node color-server.cjs",
      "options": {
        "cwd": "${workspaceFolder}/outreach-v2"
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[COLOR SERVER\\]",
          "endsPattern": "^\\[COLOR SERVER\\]"
        }
      }
    }
  ]
}
